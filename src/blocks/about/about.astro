---
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import EurFlag from '../../assets/eur.webp';
import UsFlag from '../../assets/us.webp';
import ChfFlag from '../../assets/chf.webp';
import UkFlag from '../../assets/uk.webp';
import CadFlag from '../../assets/cad.webp';
import AudFlag from '../../assets/aud.webp';
import BamFlag from '../../assets/bam.webp';
import type { CurrencyRate } from '../../ts/services/RatesService';

export interface Props {
  title: string;
  linkText: string;
  strong: string;
  description: string;
  rates?: CurrencyRate[];
  lang?: 'sr' | 'en';
}

const { title, linkText, strong, description, rates = [], lang = 'sr' } = Astro.props;

const rateByCurrency = new Map(rates.map((rate) => [rate.currency, rate]));
const exchangeRatesHref = lang === 'en' ? '/en/exchange-rates' : '/kursna-lista';
const currencyLabels: Record<string, string> = {
  EUR: lang === 'en' ? 'Euro' : 'Evro',
  USD: lang === 'en' ? 'US Dollar' : 'Američki dolar',
  CHF: lang === 'en' ? 'Swiss Franc' : 'Švajcarski franak',
  GBP: lang === 'en' ? 'British Pound' : 'Britanska funta',
  CAD: lang === 'en' ? 'Canadian Dollar' : 'Kanadski dolar',
  AUD: lang === 'en' ? 'Australian Dollar' : 'Australijski dolar',
  BAM: lang === 'en' ? 'Convertible Mark' : 'Konvertibilna marka',
};
const sliderCurrencies = [
  { code: 'EUR', image: EurFlag, alt: 'flag of europe union' },
  { code: 'USD', image: UsFlag, alt: 'flag of united states' },
  { code: 'CHF', image: ChfFlag, alt: 'flag of switzerland' },
  { code: 'GBP', image: UkFlag, alt: 'flag of great britain' },
  { code: 'CAD', image: CadFlag, alt: 'flag of canada' },
  { code: 'AUD', image: AudFlag, alt: 'flag of australia' },
  { code: 'BAM', image: BamFlag, alt: 'flag of bosnia and herzegovina' },
].map((currency) => ({
  ...currency,
  label: currencyLabels[currency.code],
  rate: rateByCurrency.get(currency.code),
}));

const labels = {
  buy: lang === 'en' ? 'Buy' : 'Kupovni',
  sell: lang === 'en' ? 'Sell' : 'Prodajni',
  more: lang === 'en' ? 'Show more' : 'Prikaži više',
  unavailable: lang === 'en' ? 'Rate unavailable' : 'Kurs nije dostupan',
};
---

<section class="about">
  <div class="about__container container">
    <h2 class="about__title rw-54-600">{title}</h2>
    <p class="about__description rw-24-400">
      <strong>{strong}</strong>
      {description}
    </p>
    <a
      href="https://maps.app.goo.gl/vVKm62mFN418jrLAA"
      target="_blank"
      class="about__link btn-secondary rw-24-600"
    >
      {linkText}
      <Icon name="arrow-right" />
    </a>
  </div>
  <div class="about__infinity-slider-wrapper">
    <div class="about__infinity-slider">
      {
        sliderCurrencies.map((currency) => (
          <article class="about__currency-card" tabindex="0">
            <Image src={currency.image} alt={currency.alt} loading="lazy" decoding="async" />
            <span class="about__currency-code rw-16-600">{currency.code}</span>
            <span class="about__currency-info" aria-hidden="true">
              <Icon name="info" />
            </span>
            <div class="about__currency-tooltip">
              <p class="about__currency-title rw-20-600">
                {currency.code} - {currency.label}
              </p>
              {currency.rate ? (
                <dl class="about__currency-rates rw-16-400">
                  <div>
                    <dt>{labels.buy}</dt>
                    <dd>{currency.rate.buyRate.toFixed(2)}</dd>
                  </div>
                  <div>
                    <dt>{labels.sell}</dt>
                    <dd>{currency.rate.sellRate.toFixed(2)}</dd>
                  </div>
                </dl>
              ) : (
                <p class="about__currency-unavailable rw-16-400">{labels.unavailable}</p>
              )}
              <a class="about__currency-link rw-16-600" href={exchangeRatesHref}>
                {labels.more}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss" is:global>
  @use './about';
</style>

<script>
  import { InfinitySliderController } from '../../ts/animations/InfinitySliderController';
  if (document.querySelector('.about__infinity-slider')) new InfinitySliderController();
</script>
